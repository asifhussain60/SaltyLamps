node_modules/
dist/
.DS_Store
*.timestamp-*.mjs

# Wrangler local dev state (local D1 sqlite, cache — never real data)
.wrangler/

# Environment secrets — never commit
.env
.env.local
.env.*.local

# Editor/tool settings. launch.json defines the dev servers (vite + wrangler ports)
# and is worth sharing — every machine otherwise re-derives it. settings.local.json
# is per-machine permissions and is not.
.claude/*
!.claude/launch.json

# Wix backups taken by salty-lamps-site/scripts/backup-wix.mjs before the migration.
# Archival copies of the live shop — pages, images and the indexed-URL inventory.
# Large, regenerable while Wix is still up, and not source. Keep them, don't commit them.
backups/
