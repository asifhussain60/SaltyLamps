{
  "name": "salty-lamps-proposal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/fetch-content-snapshot.mjs && vite build && node scripts/generate-seo.mjs",
    "content:snapshot": "node scripts/fetch-content-snapshot.mjs",
    "content:refresh-staging": "CONTENT_SNAPSHOT_SOURCE=staging node scripts/fetch-content-snapshot.mjs",
    "media:optimise": "node scripts/optimise-media.mjs",
    "preview": "vite preview",
    "test:unit": "node --test test/*.test.mjs",
    "media:verify": "node scripts/media-refresh.mjs verify",
    "media:compile": "node scripts/compile-media-refresh.mjs",
    "media:verify-cutover": "node scripts/verify-media-cutover.mjs",
    "live:check": "node scripts/live-check.mjs"
  },
  "dependencies": {
    "@stripe/stripe-js": "^9.17.0",
    "bootstrap": "^5.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.0",
    "vite": "^6.4.3",
    "wrangler": "^4.95.0"
  }
}
