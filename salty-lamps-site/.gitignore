# Dependencies
node_modules/

# Build output
dist/

# Environment — contains API keys, never commit
.env
.env.local
.env.*.local
.dev.vars

# Vite temp files
vite.config.js.timestamp-*

# Wrangler local dev state (local D1 sqlite, cache — never real data)
.wrangler/

# macOS
.DS_Store

# Aura video generator: local render cache + pre-overwrite backups
.aura-render-cache/
*.bak

# D1 remote backups — contain real order data (customer emails, addresses). Never commit.
d1/backups/

# End-to-end suite (tests/) — its own npm package on purpose, so the site build
# never installs Playwright. Its dependencies, reports and traces are not source.
tests/node_modules/
tests/playwright-report/
tests/test-results/
